{
  "name": "portafolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio estático de Luis Alberto Aguilar Gasca.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run i18n:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
